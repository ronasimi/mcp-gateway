FROM node:22-bookworm-slim

ARG SUPERGATEWAY_VERSION=4.0.0

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --omit=dev "supergateway@${SUPERGATEWAY_VERSION}" \
    && npm cache clean --force \
    && command -v supergateway

COPY scripts/google-common.mjs /opt/mcp/google-common.mjs
COPY scripts/catalog-metadata.mjs /opt/mcp/catalog-metadata.mjs
COPY scripts/google-tools.mjs /opt/mcp/google-tools.mjs
COPY scripts/module-layout.mjs scripts/mcp-stdio.mjs /opt/mcp/
COPY src /opt/mcp/src
COPY scripts/google-auth.mjs /opt/mcp/google-auth.mjs

RUN chmod 0755 /opt/mcp/google-tools.mjs /opt/mcp/google-auth.mjs \
    && mkdir -p /data/google /workspace \
    && chown -R node:node /data/google /workspace

EXPOSE 8934 53682

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["sh", "-c", "curl -sS -o /dev/null --max-time 3 http://127.0.0.1:${GOOGLE_MCP_PORT:-8934}/mcp"]

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec supergateway --stdio 'node /opt/mcp/google-tools.mjs' --outputTransport streamableHttp --port ${GOOGLE_MCP_PORT:-8934} --streamableHttpPath /mcp --logLevel info"]
