.env
*.log
.DS_Store

# Durable runtime state. Keep directory placeholders, not user data.
data/searxng/*
!data/searxng/.gitkeep
data/playwright/*
!data/playwright/.gitkeep
data/memory/*
!data/memory/.gitkeep
data/workspace/*
!data/workspace/.gitkeep
data/ssh/*
!data/ssh/.gitkeep

# Google OAuth credentials/tokens. Never commit account secrets.
secrets/*
data/google/*
!data/google/.gitkeep

# Security scanner runtime data/templates/cache.
data/security/*
!data/security/.gitkeep

# Local update backups and Python bytecode.
.isolation-tools-backups/
__pycache__/
