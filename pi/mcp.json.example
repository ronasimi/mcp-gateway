{
  "mcpServers": {
    "searxng": {
      "url": "http://mcp-searxng:8888/mcp/",
      "exposure": "deferred",
      "description": "SearXNG search.",
      "timeout": 30
    },
    "playwright": {
      "url": "http://mcp-gateway:8931/mcp",
      "exposure": "deferred",
      "description": "Playwright browser.",
      "timeout": 60,
      "toolExposure": {
        "browser_close": "hidden"
      }
    },
    "memory": {
      "url": "http://mcp-gateway:8932/mcp",
      "exposure": "deferred",
      "description": "Knowledge graph memory.",
      "timeout": 30
    },
    "system": {
      "url": "http://mcp-system:8933/mcp",
      "exposure": "deferred",
      "description": "System utilities.",
      "timeout": 120
    },
    "google": {
      "url": "http://mcp-google:8934/mcp",
      "exposure": "deferred",
      "description": "Google Workspace.",
      "timeout": 120
    },
    "security": {
      "url": "http://mcp-security:8935/mcp",
      "exposure": "deferred",
      "description": "Security assessment.",
      "timeout": 330
    }
  }
}
