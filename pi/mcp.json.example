{
  "mcpServers": {
    "searxng": {
      "url": "http://mcp-searxng:8888/mcp/",
      "exposure": "deferred",
      "description": "Public web search for current information, news, URLs, and sources. Operational retrieval capability: search.",
      "timeout": 30,
      "toolExposure": {
        "engine_info": "hidden",
        "autocomplete": "hidden",
        "search": "deferred"
      }
    },
    "playwright": {
      "url": "http://mcp-gateway:8931/mcp",
      "exposure": "deferred",
      "description": "Live browser navigation, page snapshots, and page actions for reading or interacting with known URLs.",
      "timeout": 60,
      "toolExposure": {
        "browser_close": "hidden"
      }
    },
    "memory": {
      "url": "http://mcp-gateway:8932/mcp",
      "exposure": "deferred",
      "description": "Knowledge graph memory. Retrieval capability: search_nodes; use targeted entity operations for reads and writes.",
      "timeout": 30,
      "toolExposure": {
        "read_graph": "hidden",
        "search_nodes": "deferred"
      }
    },
    "system": {
      "url": "http://mcp-system:8933/mcp",
      "exposure": "deferred",
      "description": "System utilities.",
      "timeout": 120
    },
    "google": {
      "url": "http://mcp-google:8934/mcp",
      "exposure": "deferred",
      "description": "Google Workspace.",
      "timeout": 120
    },
    "security": {
      "url": "http://mcp-security:8935/mcp",
      "exposure": "deferred",
      "description": "Security assessment.",
      "timeout": 330
    }
  }
}
