    "memory": {
      "url": "http://mcp-gateway:8932/mcp",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 30000,
      "searchKeywords": {
        "*": [
          "memory",
          "remember",
          "recall",
          "knowledge",
          "entity",
          "relation",
          "observation"
        ],
        "read_graph": [
          "memory graph",
          "all memory",
          "knowledge graph",
          "stored memory"
        ],
        "search_nodes": [
          "search memory",
          "find memory",
          "recall entity",
          "lookup memory",
          "memory search"
        ],
        "open_nodes": [
          "open memory node",
          "read entity",
          "entity details",
          "memory entity"
        ],
        "create_entities": [
          "remember entity",
          "store fact",
          "create memory",
          "save entity"
        ],
        "create_relations": [
          "remember relation",
          "link entities",
          "store relationship"
        ],
        "add_observations": [
          "add memory",
          "remember observation",
          "append fact",
          "store observation"
        ],
        "delete_entities": [
          "forget entity",
          "delete memory",
          "remove entity"
        ],
        "delete_observations": [
          "forget observation",
          "delete fact",
          "remove observation"
        ],
        "delete_relations": [
          "forget relation",
          "remove relationship",
          "delete relation"
        ]
      },
      "lifecycle": "lazy",
      "description": "Durable graph memory for facts, entities, relationships, and observations that should persist across conversations. Use for remember/recall/store-memory tasks, not ordinary files."
    },
