  "settings": {
    "directTools": false,
    "namespaceProxyTools": false,
    "allowInstall": false,
    "scriptMode": false,
    "exposeResources": false,
    "hostConfigDiscovery": "off",
    "warnOnLargeDirectTools": true,
    "toolResultRendering": "compact",
    "freezeDirectTools": true,
    "strictDirectToolArguments": true,
    "deferWithMissingMetadata": false,
    "outputGuard": {
      "maxBytes": 12288,
      "maxLines": 300,
      "detailsMaxBytes": 2048
    }
  }
