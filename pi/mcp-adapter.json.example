{
  "mcpServers": {
    "searxng": {
      "url": "http://mcp-searxng:8888/mcp/",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 30000,
      "searchKeywords": {
        "*": [
          "web",
          "search",
          "internet",
          "searxng",
          "news",
          "headlines",
          "latest",
          "current",
          "research",
          "site",
          "url"
        ]
      },
      "lifecycle": "lazy",
      "description": "Public web search and current-information discovery. Use for internet search, news discovery, finding URLs, sources, products, documentation, or recent facts; use Playwright to open/read a known page."
    },
    "playwright": {
      "url": "http://mcp-gateway:8931/mcp",
