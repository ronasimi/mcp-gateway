# Generated automatically by ./scripts/init.sh when .env does not exist.
# Used as the x-api-key required by the SearXNG MCP endpoint and web UI.
MCP_GATEWAY_AUTH_TOKEN=replace-me

# Loopback ports for host-native MCP clients. Container clients use ai-local.
MCP_GATEWAY_PORT=8888
PLAYWRIGHT_HOST_PORT=8931
MEMORY_HOST_PORT=8932

# Container resource limits.
MCP_GATEWAY_MEMORY=1536m
MCP_GATEWAY_CPUS=2.0
PLAYWRIGHT_SHM_SIZE=512m

# Browser lifecycle / MCP heartbeat.
PLAYWRIGHT_MCP_IDLE_TIMEOUT=300000
PLAYWRIGHT_MCP_PING_TIMEOUT_MS=30000
