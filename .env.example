SEARXNG_IMAGE=ghcr.io/whw23/searxng-http-mcp:latest
SEARXNG_SECRET=

MCP_GATEWAY_PORT=8888
PLAYWRIGHT_HOST_PORT=8931
MEMORY_HOST_PORT=8932

SEARXNG_MEMORY=512m
SEARXNG_CPUS=1.0
MCP_GATEWAY_MEMORY=1024m
MCP_GATEWAY_CPUS=1.5
PLAYWRIGHT_SHM_SIZE=512m

PLAYWRIGHT_MCP_VERSION=0.0.83
MEMORY_MCP_VERSION=2026.8.31
SUPERGATEWAY_VERSION=4.0.0
PLAYWRIGHT_MCP_IDLE_TIMEOUT=300000
PLAYWRIGHT_MCP_PING_TIMEOUT_MS=30000
PLAYWRIGHT_MCP_SHARED_BROWSER_CONTEXT=true

# Bounded-discovery system tools MCP
SYSTEM_TOOLS_HOST_PORT=8933
SYSTEM_TOOLS_MEMORY=768m
SYSTEM_TOOLS_CPUS=1.0
SYSTEM_TOOLS_TIMEOUT_MS=30000
SYSTEM_TOOLS_MAX_OUTPUT=65536

# Host paths exposed only to the mcp-system container. Host root is mounted RO.
HOST_ROOT_PATH=/
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Set this to the directory Pi should manipulate with image/document tools.
# Example: /home/ron/Projects
MCP_WORKSPACE_PATH=./data/workspace

# Mutating router/container operations are opt-in. Diagnostic/read tools work with false.
DOCKER_ALLOW_WRITE=false
DOCKER_ALLOW_EXEC=false
OPENWRT_ALLOW_WRITE=false


# Google Workspace MCP (optional; bounded discovery only)
GOOGLE_MCP_HOST_PORT=8934
GOOGLE_MCP_MEMORY=384m
GOOGLE_MCP_CPUS=0.75
GOOGLE_TOOLS_MAX_OUTPUT=65536
GOOGLE_OAUTH_CALLBACK_PORT=53682

# Host-side secret files. Never commit these.
GOOGLE_OAUTH_CLIENT_SOURCE=./secrets/google-oauth-client.json
GOOGLE_TOKEN_KEY_SOURCE=./secrets/google-token.key

# Default is broad read-only access for Gmail, Calendar, and Drive.
# Gmail readonly and Drive readonly are restricted Google scopes; see README.
GOOGLE_SCOPES="https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.readonly https://www.googleapis.com/auth/calendar.freebusy https://www.googleapis.com/auth/drive.readonly"

# Mutating account actions are independently opt-in.
GOOGLE_GMAIL_WRITE=false
GOOGLE_CALENDAR_WRITE=false
GOOGLE_DRIVE_WRITE=false
