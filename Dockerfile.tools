FROM node:22-bookworm-slim

ARG PLAYWRIGHT_MCP_VERSION=0.0.83
ARG MEMORY_MCP_VERSION=2026.8.31
ARG SUPERGATEWAY_VERSION=4.0.0

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=0 \
    NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       chromium \
       curl \
       tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --omit=dev \
       "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}" \
       "@modelcontextprotocol/server-memory@${MEMORY_MCP_VERSION}" \
       "supergateway@${SUPERGATEWAY_VERSION}" \
    && npm cache clean --force \
    && command -v node \
    && command -v playwright-mcp \
    && command -v mcp-server-memory \
    && command -v supergateway \
    && command -v chromium

COPY scripts/gateway-entrypoint.sh /usr/local/bin/mcp-gateway-entrypoint
COPY scripts/searxng-proxy.mjs /usr/local/lib/mcp-gateway/searxng-proxy.mjs
COPY scripts/healthcheck.sh /usr/local/bin/mcp-gateway-healthcheck

RUN chmod +x /usr/local/bin/mcp-gateway-entrypoint /usr/local/bin/mcp-gateway-healthcheck \
    && mkdir -p /data/playwright /data/memory /usr/local/lib/mcp-gateway \
    && chown -R node:node /data /usr/local/lib/mcp-gateway

EXPOSE 8888 8931 8932

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/local/bin/mcp-gateway-healthcheck"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/mcp-gateway-entrypoint"]
